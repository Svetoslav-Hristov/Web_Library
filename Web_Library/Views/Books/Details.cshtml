@model Book
@{
    ViewData["Title"] = "Book Details";
    var message = TempData["SuccessMessage"] as string;
}
 

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-success" role="alert">
        @message
    </div>

}


<div class="container mt-4">
    <div class="row">
        <div class="col-md-4 text-center">
            <img src="~/Images/@Model.CoverImageUrl"
                 alt="Book cover"
                 class="img-fluid rounded shadow" />
        </div>
        <div class="col-md-8">
            <h2>@Model.Title</h2>
            <h5 class="text-muted">by @Model.Author</h5>
            <h7>year of published @Model.Year</h7>
            <p>Genre @Model.Genre</p>
            <hr />

            <p>@Model.Description</p>
        </div>

    </div>
</div>
<hr />

<div class="d-flex gap-2">

    <a asp-controller="Books"
       asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-outline-warning">
        Edit
    </a>

    <form asp-controller="Books"
          asp-action="Delete"
          asp-route-id="@Model.Id"
          method="post"
          onsubmit="return confirm('Are you sure you want to delete this book?');">

        <button type="submit" class="btn btn btn-outline-danger ">
            Delete
        </button>
    </form>

</div>
