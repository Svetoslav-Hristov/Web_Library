@model IEnumerable<RegisterModelView>
@{
    var message = TempData["NotAvilable"] as string;

    var blockedUser = TempData["IncorectUser"] as string;

}

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-danger" role="alert">
        @message
    </div>

}
@if (!string.IsNullOrEmpty(blockedUser))
{
    <div class="alert alert-danger" role="alert">
        @blockedUser
    </div>

}
<div class="container-fluid px-0">
    <div class="row g-0">

        <!-- LEFT SIDEBAR -->
        <aside class="col-md-3 col-lg-2 bg-light border-end min-vh-100 p-3">
            <h5 class="mb-3">Menu</h5>

            <div class="d-flex flex-column gap-2">
                <a asp-controller="Users"
                   asp-action="Index"
                   class="btn btn-outline-primary">
                    👤 Users List
                </a>

                <a asp-controller="Systems"
                   asp-action="CreateLoan"
                   class="btn btn-outline-success">
                    ➕ Create Loan
                </a>

                <a asp-controller="Books"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    📚 Books
                </a>
            </div>
        </aside>
        <!-- 🟨 MAIN CONTENT -->
        <main class="col-md-9 col-lg-10 p-4">

            <h2 class="mb-4">📚 Borrowed Books Register</h2>

            <!-- 🔍 Search -->
            <form method="get" class="mb-3">
                <div class="input-group">
                    <input type="text"
                           name="search"
                           class="form-control"
                           placeholder="Search by user name..."
                           value="@Context.Request.Query["search"]" />

                    <button class="btn btn-outline-primary" type="submit">
                        Search
                    </button>
                </div>
            </form>

            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    No records found.
                </div>
            }
            else
            {
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>User</th>
                            <th>Book</th>
                            <th>Pick-up date</th>
                            <th>Return date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Users"
                                       asp-action="Details"
                                       asp-route-id="@item.UserId">
                                        @item.UserFirstName @item.UserLastName
                                    </a>
                                </td>

                                <td>
                                    <a asp-controller="Books"
                                       asp-action="Details"
                                       asp-route-id="@item.BookId">
                                        @item.BookTitle
                                    </a>
                                </td>

                                <td>@(item.PickUpDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                                <td>@(item.ReturnDate?.ToString("dd.MM.yyyy") ?? "-")</td>

                                <td>
                                    <span class="badge bg-secondary">@item.Status</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

        </main>

    </div>
</div>
        